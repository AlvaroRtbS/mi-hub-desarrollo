# Copia este archivo a `.env.local` (dentro de /web) y rellena los valores.
# NUNCA subas .env ni .env.local al repositorio.

# --- Supabase (web + móvil) ---
# Obténlos en https://supabase.com/dashboard → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Solo para scripts del lado del servidor (migración, tareas admin). Esta clave da acceso TOTAL — protegerla.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- TrainerStudio (solo para el script de migración, no para la app) ---
# Generar en TrainerStudio: Settings → API Keys → Create
TS_API_KEY=tu_api_key_de_trainerstudio_aqui
TS_BASE=https://api.trainerstudio.io

# --- IA (Gemini free) ---
# Necesaria para: resumen de clienta, generar programa, informe semanal y chat-coach.
# Sin ella, las 4 rutas de /api/ia/* devuelven 500.
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# --- Push notifications (Web Push / VAPID) ---
# Genera el par con: npx web-push generate-vapid-keys
# La pública va también al cliente (NEXT_PUBLIC_), la privada NUNCA se expone.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui

# --- Crons (Vercel Pro) ---
# Secreto que Vercel Cron envía como `Authorization: Bearer ...`.
# IMPORTANTE: en producción DEBE estar definido. Si falta, los endpoints de
# /api/cron/* quedan abiertos (fail-open pensado solo para desarrollo local).
CRON_SECRET=genera_un_secreto_largo_aleatorio

# --- Contrato RGPD (webhook del Google Form vía Apps Script) ---
# Secreto compartido que el Apps Script envía en la cabecera x-contrato-secret.
CONTRATO_WEBHOOK_SECRET=genera_un_secreto_largo_aleatorio

# --- Puente WhatsApp (bot local → mi-hub) ---
# Secreto que el bot local envía para escribir mensajes entrantes.
WHATSAPP_BRIDGE_SECRET=genera_un_secreto_largo_aleatorio
# Token de verificación del webhook de Meta (solo si usas la API oficial de WhatsApp).
WHATSAPP_VERIFY_TOKEN=tu_verify_token_aqui
